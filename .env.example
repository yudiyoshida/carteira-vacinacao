# Development values of docker-compose.yml. Copy to .env, which stays out of git, to override them.
# ConnectionStrings__Default comes from POSTGRES_*, and ForwardedHeaders__KnownProxies follows the fixed IP of the web service.
POSTGRES_DB=vaccination_card
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host ports of the db, api and web services.
DB_PORT=5432
API_PORT=8080
WEB_PORT=4200

Jwt__Issuer=vaccination-card
Jwt__Audience=vaccination-card
Jwt__AccessTokenSecret=development-access-token-secret-with-at-least-32-bytes
Jwt__RefreshTokenSecret=development-refresh-token-secret-with-at-least-32-bytes
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# A browser may refuse a Secure cookie on http://localhost; only then, in development, use false.
RefreshCookie__Secure=true

Database__MigrateOnStartup=true
Database__SeedOnStartup=true

App__TimeZone=America/Sao_Paulo

OpenApi__Enabled=true
