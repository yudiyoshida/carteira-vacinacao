@baseUrl = http://localhost:8080
@accessToken = {{login.response.body.$.accessToken}}

### Verificar a saúde da API
GET {{baseUrl}}/health

### Entrar
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "operador@demo.local",
  "password": "Demo@2026!"
}

### Renovar a sessão
# Exige o cookie refresh_token do login. Em http://localhost, suba a API com RefreshCookie__Secure=false.
POST {{baseUrl}}/api/v1/auth/refresh

### Cadastrar vacina
# @name createVaccine
POST {{baseUrl}}/api/v1/vaccines
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Hepatite A",
  "primaryDoses": 2,
  "boosterDoses": 0
}

### Consultar vacina
GET {{baseUrl}}/api/v1/vaccines/{{createVaccine.response.body.$.id}}
Authorization: Bearer {{accessToken}}

### Listar vacinas
GET {{baseUrl}}/api/v1/vaccines?search=hepatite&page=1&size=10
Authorization: Bearer {{accessToken}}

### Cadastrar pessoa
# @name createPerson
POST {{baseUrl}}/api/v1/people
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "João da Silva",
  "cpf": "111.444.777-35"
}

### Consultar pessoa
GET {{baseUrl}}/api/v1/people/{{createPerson.response.body.$.id}}
Authorization: Bearer {{accessToken}}

### Listar pessoas
GET {{baseUrl}}/api/v1/people?search=joao&page=1&size=20
Authorization: Bearer {{accessToken}}

### Registrar vacinação
# @name registerVaccination
POST {{baseUrl}}/api/v1/people/{{createPerson.response.body.$.id}}/vaccinations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "vaccineId": "{{createVaccine.response.body.$.id}}",
  "dose": { "type": "Primary", "number": 1 },
  "appliedOn": "2026-01-15"
}

### Consultar vacinação
GET {{baseUrl}}/api/v1/people/{{createPerson.response.body.$.id}}/vaccinations/{{registerVaccination.response.body.$.id}}
Authorization: Bearer {{accessToken}}

### Corrigir data de aplicação
PATCH {{baseUrl}}/api/v1/people/{{createPerson.response.body.$.id}}/vaccinations/{{registerVaccination.response.body.$.id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "appliedOn": "2026-01-20"
}

### Consultar cartão de vacinação
GET {{baseUrl}}/api/v1/people/{{createPerson.response.body.$.id}}/vaccination-card
Authorization: Bearer {{accessToken}}

### Excluir vacinação
DELETE {{baseUrl}}/api/v1/people/{{createPerson.response.body.$.id}}/vaccinations/{{registerVaccination.response.body.$.id}}
Authorization: Bearer {{accessToken}}

### Remover pessoa
DELETE {{baseUrl}}/api/v1/people/{{createPerson.response.body.$.id}}
Authorization: Bearer {{accessToken}}

### Encerrar a sessão
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{accessToken}}
