@baseUrl = http://localhost:8080

### Verificar a saúde da API
GET {{baseUrl}}/health

### Cadastrar vacina
# @name createVaccine
POST {{baseUrl}}/api/v1/vaccines
Content-Type: application/json

{
  "name": "Hepatite A",
  "primaryDoses": 2,
  "boosterDoses": 0
}

### Consultar vacina
GET {{baseUrl}}/api/v1/vaccines/{{createVaccine.response.body.$.id}}

### Listar vacinas
GET {{baseUrl}}/api/v1/vaccines?search=hepatite&page=1&size=10

### Cadastrar pessoa
# @name createPerson
POST {{baseUrl}}/api/v1/people
Content-Type: application/json

{
  "name": "João da Silva",
  "cpf": "111.444.777-35"
}

### Consultar pessoa
GET {{baseUrl}}/api/v1/people/{{createPerson.response.body.$.id}}
