{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=vaccination_card;Username=postgres;Password=postgres"
  },
  "App": {
    "TimeZone": "America/Sao_Paulo"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "vaccination-card",
    "Audience": "vaccination-card",
    "AccessTokenSecret": "development-access-token-secret-with-at-least-32-bytes",
    "RefreshTokenSecret": "development-refresh-token-secret-with-at-least-32-bytes",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RefreshCookie": {
    "Secure": true
  },
  "OpenApi": {
    "Enabled": true
  }
}
